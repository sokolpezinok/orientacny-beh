  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "build": "vite build",
    "preview": "vite preview",
    "android:build-release": "echo \"\\033[31mApp Version: $VITE_APP_VERSION\nAndroid Version Code: $ANDROID_VERSION_CODE\\033[0m\" && vite build && cap sync && cd ./android && ./gradlew app:assembleRelease app:bundleRelease && cd .. && mkdir -p ./dist/ && cp -v ./android/app/build/outputs/bundle/release/app-release.aab ./android/app/build/outputs/apk/release/app-release-unsigned.apk ./dist/",
    "android:clean": "cd ./android && ./gradlew clean && cd ..",
    "android:open": "cap sync && cap open android",
    "visualize": "vite build --mode visualize",
    "test:i18n": "node ./tests/i18n.js"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.3.0",
