{
  "name": "orientacny-beh",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "build": "vite build",
    "preview": "vite preview",
    "android:aab-release": "cd ./android && ./gradlew app:bundleRelease && cd .. && mkdir -p ./dist/ && cp -v ./android/app/build/outputs/bundle/release/app-release.aab ./dist/app-release.aab",
    "android:apk-release": "cd ./android && ./gradlew app:assembleRelease && cd .. && mkdir -p ./dist/ && cp -v ./android/app/build/outputs/apk/release/app-release-unsigned.apk ./dist/app-release.apk",
    "android:clean": "cd ./android && ./gradlew clean && cd ..",
    "android:build": "vite build && cap sync && $npm_execpath run android:apk-release && $npm_execpath run android:aab-release",
    "android:open": "cap sync && cap open android",
    "visualize": "vite build --mode visualize",
    "test:i18n": "node ./tests/i18n.js"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.3.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/status-bar": "^8.0.3",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@ionic/core": "^8.8.14",
    "@ionic/react": "^8.8.14",
    "@ionic/react-router": "^8.8.14",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "color": "^5.0.3",
    "fast-deep-equal": "^3.1.3",
    "firebase": "^11.10.0",
    "i18next": "^25.10.10",
    "ionicons": "^8.0.13",
    "pullstate": "2.0.0-pre.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^5.0.0",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "chalk": "^5.6.2",
    "classnames": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3"
  }
}
